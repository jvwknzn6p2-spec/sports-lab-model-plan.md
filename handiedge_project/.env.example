# HandiEdge configuration — NAMES AND PLACEHOLDERS ONLY.
# Copy to `.env` and fill with real values in your own secret manager.
# NEVER commit a populated .env. All values below are placeholders.

# --- Runtime -----------------------------------------------------------------
HANDIEDGE_ENVIRONMENT=dev            # dev | staging | prod

# --- Policy (responsible gambling / jurisdiction) ----------------------------
# Comma-separated ISO-3166 alpha-2 codes. If ALLOWED is set it takes precedence.
HANDIEDGE_ALLOWED_JURISDICTIONS=     # e.g. JP,GB
HANDIEDGE_BLOCKED_JURISDICTIONS=     # e.g. US,FR
HANDIEDGE_MIN_AGE=18

# --- Odds / freshness --------------------------------------------------------
HANDIEDGE_STALE_SECONDS=300

# --- OpticOdds adapter (external; unset => NotConfigured, no live claims) -----
HANDIEDGE_OPTICODDS_BASE_URL=        # https://api.opticodds.example
HANDIEDGE_OPTICODDS_API_KEY=         # <secret>

# --- Live connector via runtime `external-tool` ------------------------------
# The runtime injects OpticOdds credentials into the connector. There is NO API
# key here by design — never add one. If the binary is absent, live CLI commands
# report ConnectorUnavailable and exit non-zero (they never fabricate data).
HANDIEDGE_EXTERNAL_TOOL_BIN=external-tool
HANDIEDGE_EXTERNAL_TOOL_TIMEOUT_S=30
HANDIEDGE_OPTICODDS_SOURCE_ID=opticodds
HANDIEDGE_OPTICODDS_TOOL_NAME=opticodds
# US sportsbooks only (connector limitation); max five per odds batch.
HANDIEDGE_OPTICODDS_SPORTSBOOKS=draftkings,fanduel,betmgm,caesars,espnbet

# --- Local data lake (raw immutable snapshots, normalized rows, datasets) ----
HANDIEDGE_DATA_DIR=./data

# --- Persistence (external; unset => in-memory stores only) ------------------
HANDIEDGE_DATABASE_URL=              # postgresql+psycopg://user:pass@host:5432/db

# --- Audit hash-chain --------------------------------------------------------
HANDIEDGE_AUDIT_LOG_PEPPER=          # <secret> required to construct AuditChain

# --- Internal metrics endpoint ----------------------------------------------
HANDIEDGE_METRICS_API_KEY=           # <secret> gate for /internal/metrics

# --- AI gateway / model providers (external; unset => routing only, no calls)-
HANDIEDGE_KIMI_K3_ENDPOINT=
HANDIEDGE_KIMI_K3_API_KEY=           # <secret>
HANDIEDGE_OPENAI_API_KEY=            # <secret>
HANDIEDGE_ANTHROPIC_API_KEY=         # <secret>
HANDIEDGE_DEFAULT_LLM_MODEL=deepseek-v4-pro
HANDIEDGE_COST_GUARD_MONTHLY_USD=    # e.g. 500.0

# --- Model registry / inference (external; unset => NotReady) ----------------
HANDIEDGE_MLFLOW_TRACKING_URI=
HANDIEDGE_MINIO_ENDPOINT=
HANDIEDGE_MINIO_ACCESS_KEY=          # <secret>
HANDIEDGE_MINIO_SECRET_KEY=          # <secret>

# --- OIDC (external; unset => UnconfiguredOIDCVerifier) ----------------------
HANDIEDGE_OIDC_ISSUER=
HANDIEDGE_OIDC_AUDIENCE=
HANDIEDGE_OIDC_JWKS_URL=
