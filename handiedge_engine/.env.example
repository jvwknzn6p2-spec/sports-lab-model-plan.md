# HandiEdge Engine — example environment. Copy to `.env` and adjust.
# NEVER commit real secrets. Secrets are read from the environment only.

# --- Core ---
HANDIEDGE_ENVIRONMENT=local
HANDIEDGE_SCHEMA_VERSION=1.0.0

# --- Database ---
# Local unit testing may use SQLite; PostgreSQL is the production default.
# SQLite:      sqlite+pysqlite:///./handiedge.db
# PostgreSQL:  postgresql+psycopg://handiedge:handiedge@localhost:5432/handiedge
HANDIEDGE_DATABASE_URL=postgresql+psycopg://handiedge:handiedge@localhost:5432/handiedge
HANDIEDGE_SQL_ECHO=false

# --- Security / limits ---
HANDIEDGE_REQUIRE_API_KEY=false
HANDIEDGE_API_KEY=
HANDIEDGE_MAX_REQUEST_BYTES=2000000
HANDIEDGE_MAX_GAMES_PER_RUN=40

# --- Prediction model adapter ---
# "fallback" = NON-PRODUCTION deterministic adapter (default).
# "xgboost"  = trained artifact bundle from HANDIEDGE_MODEL_ARTIFACT_DIR
#              (build one with: python scripts/train_xgboost.py --out artifacts/xgboost_mlb)
HANDIEDGE_MODEL_ADAPTER=fallback
HANDIEDGE_MODEL_ARTIFACT_DIR=
HANDIEDGE_CALIBRATION_ARTIFACT_PATH=

# --- Policy versions (embedded into locks + audit) ---
HANDIEDGE_DECISION_POLICY_VERSION=decision-policy-1.0.0
HANDIEDGE_SETTLEMENT_RULE_VERSION=settlement-rules-1.0.0
HANDIEDGE_CALIBRATION_VERSION=calibration-identity-1.0.0

# --- Logging ---
HANDIEDGE_LOG_LEVEL=INFO
HANDIEDGE_LOG_JSON=true

# --- Decision gates (typed thresholds; prefix HANDIEDGE_GATE_) ---
HANDIEDGE_GATE_MIN_PREDICTION_PROBABILITY=0.50
HANDIEDGE_GATE_MIN_EVIDENCE_COMPLETENESS=0.60
HANDIEDGE_GATE_MAX_MODEL_DISAGREEMENT=0.20
HANDIEDGE_GATE_MAX_DATA_STALENESS_MINUTES=720
HANDIEDGE_GATE_REQUIRE_STARTER_CONFIRMATION=true
HANDIEDGE_GATE_REQUIRE_SCHEDULE_VALIDATION=true
HANDIEDGE_GATE_MIN_HANDICAP_COVER_PROBABILITY=0.52
HANDIEDGE_GATE_BLOCK_UNRESOLVED_HANDICAP=true
HANDIEDGE_GATE_MAX_CRITICAL_RISK_COUNT=0
